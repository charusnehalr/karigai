{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@karigai/types": ["packages/types/src"],
      "@karigai/design-tokens": ["packages/design-tokens/src"],
      "@karigai/ui": ["packages/ui/src"],
      "@karigai/health-engine": ["packages/health-engine/src"],
      "@karigai/rule-engine": ["packages/rule-engine/src"],
      "@karigai/ai-engine": ["packages/ai-engine/src"]
    }
  }
}
