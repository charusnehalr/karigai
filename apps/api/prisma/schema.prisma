generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       UserProfile?
  consents      UserConsent[]
  bodyMeasurements BodyMeasurement[]
  healthConditions HealthCondition[]
  labValues     LabValue[]
  medications   Medication[]
  cycleProfile  CycleProfile?
  cycleEvents   CycleEvent[]
  symptoms      SymptomLog[]
  dietPreference DietPreference?
  fitnessPreference FitnessPreference?
  goals         Goal[]
  nutritionTargets NutritionTarget[]
  mealLogs      MealLog[]
  waterLogs     WaterLog[]
  workoutPlans  WorkoutPlan[]
  workoutSessions WorkoutSession[]
  dailyPlans    DailyPlan[]
  deviceIntegrations DeviceIntegration[]
  deviceSamples DeviceSample[]
  conversations AIConversation[]
  recommendations AIRecommendation[]
  safetyFlags   SafetyFlag[]
  auditEvents   AuditEvent[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  dateOfBirth DateTime?
  country   String?
  unitSystem String?
  onboardingStep Int @default(0)
}

model ConsentVersion {
  id        String   @id @default(cuid())
  consentType String
  version   String
  contentRef String
  required  Boolean @default(true)
  createdAt DateTime @default(now())
  consents  UserConsent[]
}

model UserConsent {
  id          String   @id @default(cuid())
  userId       String
  versionId    String
  accepted     Boolean
  acceptedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  consentVersion ConsentVersion @relation(fields: [versionId], references: [id])
}

model BodyMeasurement { id String @id @default(cuid()) userId String recordedAt DateTime @default(now()) waistCm Float? hipCm Float? bodyFatPct Float? weightKg Float? user User @relation(fields:[userId], references:[id]) }
model HealthCondition { id String @id @default(cuid()) userId String code String status String? notedAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model LabValue { id String @id @default(cuid()) userId String name String value String recordedAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model Medication { id String @id @default(cuid()) userId String name String dosage String? startDate DateTime? user User @relation(fields:[userId], references:[id]) }
model CycleProfile { id String @id @default(cuid()) userId String @unique cycleLength Int? periodLength Int? regularity String? lastPeriodStart DateTime? user User @relation(fields:[userId], references:[id]) }
model CycleEvent { id String @id @default(cuid()) userId String eventType String occurredAt DateTime flow String? user User @relation(fields:[userId], references:[id]) }
model SymptomLog { id String @id @default(cuid()) userId String symptom String severity Int? recordedAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model DietPreference { id String @id @default(cuid()) userId String @unique dietType String? restrictions Json? user User @relation(fields:[userId], references:[id]) }
model FitnessPreference { id String @id @default(cuid()) userId String @unique environment String? daysPerWeek Int? sessionMinutes Int? user User @relation(fields:[userId], references:[id]) }
model Goal { id String @id @default(cuid()) userId String goalType String targetValue String? timelineWeeks Int? user User @relation(fields:[userId], references:[id]) }
model NutritionTarget { id String @id @default(cuid()) userId String calories Int proteinG Int fatsG Int carbsG Int createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model MealLog { id String @id @default(cuid()) userId String loggedAt DateTime @default(now()) notes String? user User @relation(fields:[userId], references:[id]) items FoodItem[] }
model FoodItem { id String @id @default(cuid()) mealLogId String name String quantity String? calories Int? mealLog MealLog @relation(fields:[mealLogId], references:[id]) }
model WaterLog { id String @id @default(cuid()) userId String amountMl Int loggedAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model WorkoutPlan { id String @id @default(cuid()) userId String title String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) sessions WorkoutSession[] }
model WorkoutSession { id String @id @default(cuid()) userId String workoutPlanId String? scheduledAt DateTime? completedAt DateTime? user User @relation(fields:[userId], references:[id]) plan WorkoutPlan? @relation(fields:[workoutPlanId], references:[id]) exercises Exercise[] }
model Exercise { id String @id @default(cuid()) workoutSessionId String name String durationMin Int? reps Int? workoutSession WorkoutSession @relation(fields:[workoutSessionId], references:[id]) }
model DailyPlan { id String @id @default(cuid()) userId String date DateTime planVersionId String? user User @relation(fields:[userId], references:[id]) planVersion PlanVersion? @relation(fields:[planVersionId], references:[id]) }
model PlanVersion { id String @id @default(cuid()) createdAt DateTime @default(now()) notes String? dailyPlans DailyPlan[] }
model DeviceIntegration { id String @id @default(cuid()) userId String provider String connectedAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model DeviceSample { id String @id @default(cuid()) userId String sampleType String value Float takenAt DateTime user User @relation(fields:[userId], references:[id]) }
model AIConversation { id String @id @default(cuid()) userId String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) messages AIMessage[] }
model AIMessage { id String @id @default(cuid()) conversationId String role String content String createdAt DateTime @default(now()) conversation AIConversation @relation(fields:[conversationId], references:[id]) }
model AIRecommendation { id String @id @default(cuid()) userId String message String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model RuleSet { id String @id @default(cuid()) name String version String rules Rule[] }
model Rule { id String @id @default(cuid()) ruleSetId String code String description String ruleSet RuleSet @relation(fields:[ruleSetId], references:[id]) }
model SafetyFlag { id String @id @default(cuid()) userId String code String severity String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model AuditEvent { id String @id @default(cuid()) userId String actor String action String metadata Json? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
